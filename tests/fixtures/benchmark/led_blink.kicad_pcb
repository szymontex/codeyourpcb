(kicad_pcb (version 20240108) (generator "pcbnew") (generator_version "8.0.0")

  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )

  (paper "A4")

  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (44 "Edge.Cuts" user)
  )

  (setup
    (pad_to_mask_clearance 0)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
    )
  )

  (net 0 "")
  (net 1 "VCC")
  (net 2 "GND")
  (net 3 "LED_ANODE")
  (net 4 "BATT_POS")
  (net 5 "SW_OUT")
  (net 6 "R_LED")
  (net 7 "BYPASS")

  (gr_rect (start 95 55) (end 135 85) (layer "Edge.Cuts") (width 0.05)
    (stroke (width 0.05) (type default))
  )

  (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"
    (layer "F.Cu")
    (at 100 65)
    (property "Reference" "J1")
    (property "Value" "Power")
    (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
    (pad "1" thru_hole rect (at 0 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 4 "BATT_POS"))
    (pad "2" thru_hole oval (at 0 2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 2 "GND"))
  )

  (footprint "Button_Switch_SMD:SW_SPST_CK_RS282G05A3"
    (layer "F.Cu")
    (at 110 62)
    (property "Reference" "SW1")
    (property "Value" "ON/OFF")
    (property "Footprint" "Button_Switch_SMD:SW_SPST_CK_RS282G05A3")
    (pad "1" smd rect (at -3.1 0) (size 1.0 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "BATT_POS"))
    (pad "2" smd rect (at 3.1 0) (size 1.0 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "SW_OUT"))
  )

  (footprint "Capacitor_SMD:C_0402_1005Metric"
    (layer "F.Cu")
    (at 115 70)
    (property "Reference" "C1")
    (property "Value" "100nF")
    (property "Footprint" "Capacitor_SMD:C_0402_1005Metric")
    (pad "1" smd roundrect (at -0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 1 "VCC")
    )
    (pad "2" smd roundrect (at 0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 2 "GND")
    )
  )

  (footprint "Resistor_SMD:R_0402_1005Metric"
    (layer "F.Cu")
    (at 120 65)
    (property "Reference" "R1")
    (property "Value" "330")
    (property "Footprint" "Resistor_SMD:R_0402_1005Metric")
    (pad "1" smd roundrect (at -0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 6 "R_LED")
    )
    (pad "2" smd roundrect (at 0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 3 "LED_ANODE")
    )
  )

  (footprint "LED_SMD:LED_0603_1608Metric"
    (layer "F.Cu")
    (at 125 65)
    (property "Reference" "D1")
    (property "Value" "Red")
    (property "Footprint" "LED_SMD:LED_0603_1608Metric")
    (pad "1" smd roundrect (at -0.75 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 3 "LED_ANODE")
    )
    (pad "2" smd roundrect (at 0.75 0) (size 0.8 0.8) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 2 "GND")
    )
  )

  (footprint "Resistor_SMD:R_0402_1005Metric"
    (layer "F.Cu")
    (at 110 78)
    (property "Reference" "R2")
    (property "Value" "10k")
    (property "Footprint" "Resistor_SMD:R_0402_1005Metric")
    (pad "1" smd roundrect (at -0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 1 "VCC")
    )
    (pad "2" smd roundrect (at 0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 7 "BYPASS")
    )
  )

  (footprint "Capacitor_SMD:C_0402_1005Metric"
    (layer "F.Cu")
    (at 120 78)
    (property "Reference" "C2")
    (property "Value" "10uF")
    (property "Footprint" "Capacitor_SMD:C_0402_1005Metric")
    (pad "1" smd roundrect (at -0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 5 "SW_OUT")
    )
    (pad "2" smd roundrect (at 0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (net 2 "GND")
    )
  )




  (segment (start 120.48 65) (end 124.25 65) (width 0.25) (layer "F.Cu") (net 3))
)
