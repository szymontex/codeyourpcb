// v2-interfaces.cypcb - interface definitions for typed pin groups.
//
// An interface is a contract: a named set of pins. A module signs it with
// `implements`, and the checker holds the module to it. Both modules below
// keep their contracts, which is why this file checks clean rather than
// demonstrating the failure.
//
// The failure is worth seeing, so here is what it looks like. Drop `pin SDA`
// from TemperatureSensor and `cypcb check` refuses the file:
//
//   cypcb::sync::interface_not_satisfied
//   x module 'TemperatureSensor' implements 'I2C' without pin SDA
//
// and exits 1. It is a sync error rather than a DRC violation - a module that
// does not keep its word is not a board with a fault on it, it is a design
// that does not add up, so nothing downstream is asked to make sense of it.
//
// This file used to stop after the module definitions, with no board and no
// instance, so `cypcb check` answered "declares no board and places no
// components: nothing was checked" - an example that could not show its own
// subject.
//
// Check it with:
//   cypcb check examples/v2-interfaces.cypcb

version 1

// Standard I2C interface — 2-wire bidirectional bus
interface I2C {
    pin SDA
    pin SCL
}

// Standard SPI interface — 4-wire master/slave bus
interface SPI {
    pin MOSI
    pin MISO
    pin SCK
    pin CS
}

// Power interface — supply and ground
interface Power {
    pin VCC
    pin GND
}

// UART interface — asynchronous serial
interface UART {
    pin TX
    pin RX
}

// A sensor module exposing I2C and Power interfaces
module TemperatureSensor {
    implements I2C
    implements Power

    component U1 ic "SOIC-8" {
        value "TMP102"
        at 0mm, 0mm
    }

    component C1 capacitor "0402" {
        value 100nF
        at 6mm, 0mm
    }

    net vdd {
        U1.1
        C1.1
    }

    net gnd_int {
        U1.4
        C1.2
    }

    // I2C pins
    pin SDA
    pin SCL
    // Power pins
    pin VCC
    pin GND
}

// A display module exposing SPI and Power interfaces
module OledDisplay {
    implements SPI
    implements Power

    component U1 ic "SOIC-8" {
        value "SSD1306"
        at 0mm, 0mm
    }

    component C1 capacitor "0402" {
        value 10uF
        at 6mm, 0mm
    }

    component C2 capacitor "0402" {
        value 100nF
        at 6mm, 4mm
    }

    net vdd {
        U1.1
        C1.1
        C2.1
    }

    // SPI pins
    pin MOSI
    pin MISO
    pin SCK
    pin CS
    // Power pins
    pin VCC
    pin GND
}

// A board, so the contracts above are held to rather than only written down.
board sensor_node {
    size 40mm x 30mm
    layers 2
}

// Each instance brings its own copy of the module's parts. The pin names on
// the left are the module's; what they are wired to is this board's business.
use TemperatureSensor as TEMP at 10mm, 10mm {
    SDA = I2C_SDA
    SCL = I2C_SCL
    VCC = VBUS
    GND = GND
}

use OledDisplay as SCREEN at 25mm, 10mm {
    MOSI = SPI_MOSI
    MISO = SPI_MISO
    SCK = SPI_SCK
    CS = SPI_CS
    VCC = VBUS
    GND = GND
}
