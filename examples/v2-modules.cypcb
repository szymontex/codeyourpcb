// v2-modules.cypcb — Module definitions with nested components, pin declarations, and instantiation
//
// Demonstrates the v2 module system: encapsulating components, nets, and
// exposing pins for hierarchical design.

version 1

// A reusable voltage regulator module
module PowerSupply {
    component U1 ic "SOT-23" {
        value "LDO-3V3"
        at 0mm, 0mm
    }

    component C_IN capacitor "0402" {
        value 100nF
        at -3.5mm, 0mm
    }

    component C_OUT capacitor "0402" {
        value 10uF
        at 3.5mm, 0mm
    }

    // A net named after an exposed pin becomes the design's net when the
    // module is instantiated. One that is not stays private to the instance.
    net VIN {
        U1.1
        C_IN.1
    }

    net VOUT {
        U1.3
        C_OUT.1
    }

    net GND {
        U1.2
        C_IN.2
        C_OUT.2
    }

    // Exposed pins — the module's external interface
    pin VIN
    pin VOUT
    pin GND
}

// A simple LED driver module
module LedDriver {
    component D1 led "0603" {
        value "RED"
        at 0mm, 0mm
    }

    component R1 resistor "0402" {
        value 330ohm
        at 0mm, 3mm
    }

    pin INPUT
    pin GND

    net INPUT {
        R1.1
    }

    // Private to each instance: two drivers do not share an anode.
    net led_anode {
        R1.2
        D1.1
    }

    net GND {
        D1.2
    }
}

// Top-level board using the modules
board main_board {
    size 50mm x 30mm
    layers 2
}

// Instantiating a module copies its parts under the instance name, so the
// regulator's U1 becomes PSU_U1 and each driver gets its own D1. An instance
// says where it goes; without a placement every copy lands on the last.
use PowerSupply as PSU at 10mm, 10mm {
    VIN = V_IN
    VOUT = V_3V3
    GND = GND
}

use LedDriver as LED_PWR at 30mm, 8mm {
    INPUT = V_3V3
    GND = GND
}

// An instance turns its parts about its own origin.
use LedDriver as LED_STAT at 30mm, 20mm rotate 90 {
    INPUT = V_3V3
    GND = GND
}
