version 1

board test_board {
    size 60mm x 40mm
    layers 2
}

component R1 resistor "0402" {
    value "10k"
    at 10mm, 20mm
}

component R2 resistor "0805" {
    value "4.7k"
    at 25mm, 20mm
    rotate 90
}

component C1 capacitor "0603" {
    value "100nF"
    at 40mm, 20mm
    rotate 180
}

component U1 ic "SOIC-8" {
    value "NE555"
    at 25mm, 10mm
}

component J1 connector "PIN-HDR-1x2" {
    value "PWR"
    at 5mm, 10mm
    rotate 270
}

component LED1 led "0805" {
    value "RED"
    at 50mm, 20mm
}
