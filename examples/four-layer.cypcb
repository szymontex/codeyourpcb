// A four-layer board, to keep the inner copper honest.
//
// Both export presets used to ship an empty inner-layer list, so a board like
// this exported as though it had two: every trace on In1 or In2 was missing
// from the file set and nothing said so. The exporter reads the stack the
// board declares now, and this example is what keeps it doing that.
//
//   cypcb export examples/four-layer.cypcb --dry-run

board four_layer {
    size 30mm x 20mm
    layers 4
    fab jlcpcb

    // The build a four-layer board is actually pressed from, and the only
    // example that states one for a rigid board. Two sheets of prepreg around
    // a core, half-ounce foil inside and one ounce out, which is what a house
    // quotes for 1.57mm.
    //
    // It is here because several things read a stack and had nothing rigid to
    // read: the 3D view places inner copper by the stack's own running sum
    // rather than by an even spread, and the checker asks the stack what a
    // trace's impedance is.
    //
    // Note what this stack cannot answer, because it is the ordinary case
    // rather than a gap: prepreg on one side of each inner layer and a core on
    // the other means neither is centred between matching dielectrics, and the
    // symmetric-stripline form is the only inner one this project has. `Top`
    // and `Bottom` answer as microstrips; `In1` and `In2` answer nothing, and
    // saying nothing is the right answer rather than a number from a form that
    // does not describe them.
    stackup {
        copper "F.Cu" 1oz
        prepreg "dielectric 1" 0.2mm material "7628" dk 4.5 df 0.02
        copper "In1.Cu" 0.5oz
        core "dielectric 2" 1.065mm material "FR4" dk 4.6 df 0.018
        copper "In2.Cu" 0.5oz
        prepreg "dielectric 3" 0.2mm material "7628" dk 4.5 df 0.02
        copper "B.Cu" 1oz

        finish "HASL"
    }
}

footprint PAD1 {
    description "one square pad, drilled so it reaches every layer"
    courtyard 2mm x 2mm

    // Drilled on purpose. Without it the pad is surface copper on the top
    // layer only, and the `SIG` trace below - which this example puts on
    // Inner1 - joined two pads it could not reach. `cypcb check` said so all
    // along: four pins, none of them reached by any copper.
    pad 1 rect at 0mm, 0mm size 1.6mm x 1.6mm drill 0.8mm
}

component J1 connector "PAD1" {
    value "in"
    at 5mm, 10mm
}

component J2 connector "PAD1" {
    value "out"
    at 25mm, 10mm
}

component J3 connector "PAD1" {
    value "up"
    at 15mm, 3mm
}

component J4 connector "PAD1" {
    value "down"
    at 15mm, 17mm
}

// A second pair, joined on the other inner layer. Without them In2 was a file
// that existed and held pads, and nothing in the repository ever put copper
// on it - which is how an off-by-one in the layer numbering survived: it
// would have moved this trace into In2 and nobody would have looked.
component J5 connector "PAD1" {
    value "in2"
    at 5mm, 5mm
}

component J6 connector "PAD1" {
    value "out2"
    at 25mm, 5mm
}

net SIG {
    J1.1
    J2.1
}

// Crosses SIG, so the router has to change layer and place vias to get past
// it - which is how a four-layer board collects blind and buried vias without
// anybody asking for one.
net CROSS {
    J3.1
    J4.1
}

net SIG2 {
    J5.1
    J6.1
}

trace SIG {
    from J1.1
    to J2.1
    layer Inner1
    width 0.2mm
}

trace SIG2 {
    from J5.1
    to J6.1
    layer Inner2
    width 0.2mm
}
