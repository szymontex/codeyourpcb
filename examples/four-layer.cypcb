// A four-layer board, to keep the inner copper honest.
//
// Both export presets used to ship an empty inner-layer list, so a board like
// this exported as though it had two: every trace on In1 or In2 was missing
// from the file set and nothing said so. The exporter reads the stack the
// board declares now, and this example is what keeps it doing that.
//
//   cypcb export examples/four-layer.cypcb --dry-run

board four_layer {
    size 30mm x 20mm
    layers 4
}

footprint PAD1 {
    description "one square pad, drilled so it reaches every layer"
    courtyard 2mm x 2mm

    // Drilled on purpose. Without it the pad is surface copper on the top
    // layer only, and the `SIG` trace below - which this example puts on
    // Inner1 - joined two pads it could not reach. `cypcb check` said so all
    // along: four pins, none of them reached by any copper.
    pad 1 rect at 0mm, 0mm size 1.6mm x 1.6mm drill 0.8mm
}

component J1 connector "PAD1" {
    value "in"
    at 5mm, 10mm
}

component J2 connector "PAD1" {
    value "out"
    at 25mm, 10mm
}

component J3 connector "PAD1" {
    value "up"
    at 15mm, 3mm
}

component J4 connector "PAD1" {
    value "down"
    at 15mm, 17mm
}

net SIG {
    J1.1
    J2.1
}

// Crosses SIG, so the router has to change layer and place vias to get past
// it - which is how a four-layer board collects blind and buried vias without
// anybody asking for one.
net CROSS {
    J3.1
    J4.1
}

trace SIG {
    from J1.1
    to J2.1
    layer Inner1
    width 0.2mm
}
