// Routing E2E test fixture
// 3 components with generous spacing for reliable pad clicks
// 3 nets connecting them in known topology
version 1

board routing_test {
    size 80mm x 60mm
    layers 2
}

component R1 resistor "0805" {
    value "10k"
    at 20mm, 30mm
}

component R2 resistor "0805" {
    value "4.7k"
    at 50mm, 30mm
}

// An LED on the built-in 0805 land pattern, with its pads named for what
// they are and the cathode marked on the silkscreen. The built-in "0805"
// carries no polarity mark, so nothing on it says which way round the LED
// goes.
footprint LED_0805 {
    description "0805 LED, anode left, cathode marked right"
    courtyard 4mm x 2mm
    pad A rect at -0.95mm, 0mm size 1mm x 1.45mm
    pad K rect at 0.95mm, 0mm size 1mm x 1.45mm
    silk line 1.75mm, -0.9mm to 1.75mm, 0.9mm width 0.12mm
}

component LED1 led "LED_0805" {
    value "RED"
    at 50mm, 50mm
}

net POWER {
    R1.1
    R2.1
}

net SIGNAL {
    R1.2
    LED1.A
}

net GROUND {
    R2.2
    LED1.K
}
