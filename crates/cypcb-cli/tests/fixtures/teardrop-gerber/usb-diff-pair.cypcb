// usb-diff-pair.cypcb - two nets that carry one signal.
//
// A differential receiver reads the difference between its two inputs, so the
// half that arrives late is the half that ruins the reading. `diffpair` names
// the two nets as one signal and the checker measures the copper: the skew
// between them against the fabricator's length-match tolerance, 0.5mm on
// JLCPCB's standard process.
//
// The two halves here run between headers placed level with each other, so both
// traces are the same length and the pair passes. Move one header along the
// board and `cypcb check` names the pair and prints both lengths.
//
// Each half states the impedance it wants - 90ohm is what a USB pair is
// specified at - and the checker measures that against the stack. This board
// states the stack that holds them - 0.41mm of FR4 under 1oz copper - so the
// 0.2mm traces really are near 90 ohm and the checker measures it rather than
// taking the number on faith. A board that states no stackup gets one
// `impedance` line per net instead: `Not checked - not passed`, because
// silence from a checker reads as a pass.
//
// The gap between the halves is not checked: that is the other half of a
// differential-pair rule and needs the router to place them alongside each
// other first.
//
// Check it with:
//   cypcb check examples/usb-diff-pair.cypcb
//
// It reports 4 unconnected pins - each header's second pin is spare - and
// exits 1. The pair itself is clean: no skew, no clearance fault.

version 1

board usb_diff_pair {
    size 30mm x 20mm
    layers 2
    fab jlcpcb

    // What the traces below are measured against. A microstrip's impedance is
    // its width, its height above the plane under it and what is in between;
    // without these three the checker can only say it was not asked.
    stackup {
        copper "F.Cu" 1oz
        core "dielectric 1" 0.41mm material "FR4" dk 4.6 df 0.018
        copper "B.Cu" 1oz

        finish "HASL"
    }
}

component J1 connector "PIN-HDR-1x2" {
    value "USB in"
    at 5mm, 8mm
    rotate 90
}

component J2 connector "PIN-HDR-1x2" {
    value "USB out"
    at 25mm, 8mm
    rotate 90
}

component J3 connector "PIN-HDR-1x2" {
    value "USB in"
    at 5mm, 13mm
    rotate 90
}

component J4 connector "PIN-HDR-1x2" {
    value "USB out"
    at 25mm, 13mm
    rotate 90
}

net USB_DP [impedance 90ohm] {
    J1.1
    J2.1
}

net USB_DM [impedance 90ohm] {
    J3.1
    J4.1
}

diffpair USB {
    USB_DP
    USB_DM
}

trace USB_DP {
    from J1.1
    to J2.1
    layer Top
    width 0.2mm
}

trace USB_DM {
    from J3.1
    to J4.1
    layer Top
    width 0.2mm
}
